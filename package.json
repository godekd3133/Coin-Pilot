{
  "name": "coin-pilot",
  "version": "2.0.0",
  "description": "Oversold-reaction scalping auto-trader for Upbit with delayed rebound confirmation and a real-time dashboard",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "backtest": "node src/scripts/runBacktest.js",
    "validate:scalping": "node src/scripts/validateScalping.js",
    "validate:scalping:fixed": "SCALP_VALIDATION_FIXED=true node src/scripts/validateScalping.js",
    "validate:scalping:segments": "node src/scripts/validateScalpingSegments.js",
    "validate:scalping:no-trade-fill": "node src/scripts/validateScalpingNoTradeFill.js",
    "research:htf-momentum": "node src/scripts/validateHigherTimeframeMomentum.js",
    "research:htf-momentum:fetch": "node src/scripts/fetchHigherTimeframeMomentumCandles.js",
    "research:daily-momentum:fetch": "node src/scripts/fetchDailyMomentumCandles.js",
    "research:daily-momentum": "node src/scripts/validateDailyMomentumVariants.js",
    "research:daily-momentum:robustness": "node src/scripts/validateDailyMomentumRobustness.js",
    "research:daily-momentum:rolling": "node src/scripts/validateDailyMomentumRollingWindows.js",
    "research:daily-momentum:benchmark-confirmation": "node src/scripts/validateDailyMomentumBenchmarkConfirmation.js",
    "research:daily-market-neutral": "node src/scripts/validateDailyMarketNeutral.js",
    "research:momentum-shadow:status": "node src/scripts/momentumShadowStatus.js",
    "research:momentum-shadow:preflight": "node src/scripts/preflightMomentumShadowCandidate.js",
    "research:momentum-shadow:verify-evidence": "node src/scripts/verifyMomentumShadowEvidenceSnapshot.js",
    "research:momentum-shadow:export-evidence": "node src/scripts/exportMomentumShadowEvidence.js",
    "research:momentum-shadow:quotes": "node src/scripts/measureMomentumShadowQuotes.js",
    "research:quote-cost-compatibility": "node src/scripts/checkQuoteExecutionCostCompatibility.js",
    "research:live-execution-evidence": "node src/scripts/reconcileLiveExecutionEvidence.js",
    "research:paper:cohort": "node src/scripts/summarizePaperForwardCohort.js",
    "research:paper:exit-evidence": "node src/scripts/analyzePaperExitEvidence.js",
    "research:paper:strict-only-preflight": "node src/scripts/preflightStrictOnlyForward.js",
    "research:momentum-shadow:start-if-ready": "node src/scripts/startMomentumShadowCandidateIfReady.js",
    "research:momentum-shadow:start-quote-cross-if-ready": "MOMO_SHADOW_CANDIDATE_PROFILE=quote_cross node src/scripts/startMomentumShadowCandidateIfReady.js",
    "verify:pwa": "node src/scripts/verifyPwaShell.js",
    "validate:scalping:portfolio": "node src/scripts/validatePortfolio.js",
    "compare:scalping": "node src/scripts/compareScalpingVariants.js",
    "validate:shadow": "node src/scripts/validateShadowCandidate.js",
    "paper:smoke": "node src/scripts/runPaperSmoke.js",
    "paper:forward": "PAPER_FORWARD_MODE=true node src/scripts/runPaperSmoke.js",
    "optimize": "node src/scripts/runOptimization.js",
    "dashboard": "node src/scripts/runDashboard.js",
    "dashboard:paper": "node src/scripts/runPaperDashboard.js",
    "dashboard:staging": "node src/scripts/runStagingDashboard.js",
    "ai:smoke": "node src/scripts/runAiAdvisorSmoke.js",
    "ai:replay": "node src/scripts/runAiHistoricalReplay.js",
    "ai:robustness": "node src/scripts/runAiReplayRobustness.js",
    "test": "NODE_ENV=test node --test",
    "lint": "eslint ."
  },
  "keywords": [
    "upbit",
    "cryptocurrency",
    "trading",
    "automation",
    "machine-learning",
    "backtesting",
    "optimization",
    "genetic-algorithm",
    "technical-analysis",
    "sentiment-analysis"
  ],
  "author": "godekd3133",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godekd3133/Coin-Pilot.git"
  },
  "bugs": {
    "url": "https://github.com/godekd3133/Coin-Pilot/issues"
  },
  "homepage": "https://github.com/godekd3133/Coin-Pilot#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "sentiment": "^5.0.2",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
