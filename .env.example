# ============================================
# Coin Pilot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# UPBIT API CREDENTIALS (Required for trading)
# ============================================
# Get your API keys from: https://upbit.com/mypage/open_api_management
# WARNING: Never commit your actual API keys to version control!

UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here
# Read-only/order HTTP timeout. Prevents a hung Upbit socket from stopping a paper cycle forever.
UPBIT_REQUEST_TIMEOUT_MS=10000
# Optional research throttle when multiple read-only runners share one public
# IP. The normal single-process default remains 120ms; use a larger value for
# concurrent paper studies to leave rate-limit headroom.
# UPBIT_MIN_REQUEST_INTERVAL_MS=250

# ============================================
# TRADING MODE
# ============================================
# true  = Paper trading (simulated, no real money)
# false = Live trading (real money, use with caution!)

DRY_RUN=true

# ============================================
# STRATEGY: OVERSOLD REACTION SCALPING
# ============================================
# The default strategy waits for a completed 1-minute candle to confirm
# an oversold rebound, then re-checks the market after a 1-5 second delay.
TRADING_STRATEGY=oversold_reaction_scalping
SCALP_CANDLE_UNIT=1
SCALP_RSI_PERIOD=14
SCALP_RSI_OVERSOLD=30
SCALP_RSI_OVERBOUGHT=70
SCALP_OVERSOLD_LOOKBACK=1
SCALP_CANDLE_COUNT=120
# Maximum age of the newest candle allowed at entry. 0 uses an adaptive
# candle-unit default (90 seconds for 1-minute candles).
SCALP_MAX_CANDLE_AGE_SECONDS=0
SCALP_MIN_REBOUND_PERCENT=0.15
# 0 disables the research-only exhaustion guard. A positive value rejects a
# rebound that already moved beyond this percentage before delayed entry.
SCALP_MAX_REBOUND_PERCENT=0
SCALP_MIN_RSI_RECOVERY=2
SCALP_MIN_VOLUME_RATIO=1.0
SCALP_VOLUME_LOOKBACK=20
SCALP_MIN_CLOSE_STRENGTH=0.65
SCALP_TREND_PERIOD=30
SCALP_TREND_SLOPE_LOOKBACK=3
SCALP_MIN_TREND_SLOPE_PERCENT=-0.2
SCALP_REQUIRE_PREVIOUS_HIGH_BREAK=true
# 0 disables the signal-candle volatility guard. Test non-zero values in holdout first.
SCALP_MAX_SIGNAL_RANGE_PERCENT=0
# 0 disables the minimum signal-candle movement floor. Validate non-zero values first.
SCALP_MIN_SIGNAL_RANGE_PERCENT=0
# Optional portfolio-wide regime filter. Keep disabled until a multi-market
# holdout confirms it improves the shared portfolio, not just trade count.
SCALP_MARKET_REGIME_ENABLED=false
SCALP_MARKET_REGIME_LOOKBACK=5
SCALP_MARKET_REGIME_MIN_BREADTH=0.5
SCALP_MARKET_REGIME_MIN_RETURN_PERCENT=-0.2
# Portfolio diagnostic only: wait for next candle bullish close before entry.
SCALP_PORTFOLIO_REQUIRE_NEXT_CANDLE_BULLISH=false
# Research-only volatility-target sizing for shared-portfolio replay. Zero
# preserves fixed exposure and does not change runtime/live behavior.
SCALP_PORTFOLIO_VOLATILITY_LOOKBACK_CANDLES=20
SCALP_PORTFOLIO_VOLATILITY_TARGET_PERCENT=0
# Research-only price invalidation exit. Zero keeps the fixed max-hold path.
SCALP_PORTFOLIO_REFERENCE_BREAK_EXIT_PERCENT=0
SCALP_PORTFOLIO_REFERENCE_BREAK_MIN_HOLD_MINUTES=0
# Optional rebound filter: reject a rebound whose close already sits at/above
# the overbought line. Keep false until a fixed-config holdout supports it.
SCALP_REQUIRE_REBOUND_BELOW_OVERBOUGHT=false
# Alternate signal profiles (trend_rebound, momentum_breakout, bb_reclaim)
# consume these indicators; the default rsi_rebound profile does not. They are
# promotion-contract fields: the live gate compares them against the report.
BB_PERIOD=20
BB_STD_DEV=2
EMA_LONG=60
SCALP_SIGNAL_PROFILE=rsi_rebound
SCALP_ENTRY_DELAY_MIN_MS=1000
SCALP_ENTRY_DELAY_MAX_MS=5000
SCALP_MAX_ENTRY_RETRACE_PERCENT=0.25
SCALP_MAX_ENTRY_CHASE_PERCENT=0.35
# Optional protective exits. Zero activation keeps the fixed stop/take model.
# Enable only after a separate historical holdout and forward shadow study.
SCALP_BREAK_EVEN_TRIGGER_PERCENT=0
SCALP_BREAK_EVEN_OFFSET_PERCENT=0.05
SCALP_TRAILING_ACTIVATION_PERCENT=0
SCALP_TRAILING_STOP_PERCENT=0
SCALP_MAX_HOLD_MINUTES=30
# Loss-only early exit candidate; 0 preserves the fixed max-hold contract.
SCALP_MAX_LOSING_HOLD_MINUTES=0
# Winner hold extension candidate; 0 preserves the fixed max-hold contract.
# A positive value lets a position still profitable at the max-hold boundary
# keep holding for up to this many extra minutes with a break-even floor.
SCALP_WINNER_EXTEND_MINUTES=0
# Minimum profit vs entry required to qualify for the extension (percent).
SCALP_WINNER_EXTEND_MIN_PROFIT_PERCENT=0
# Research-only sidecar: replay the same confirmed strict BUY in a separate
# winner-hold book. This does not change strict paper or live execution.
SCALP_WINNER_SHADOW_EXTEND_MINUTES=0
SCALP_WINNER_SHADOW_EXTEND_MIN_PROFIT_PERCENT=0
# Optional A/B entry filter: with strict max rebound disabled, winner shadow
# mirrors only strict confirmed BUY signals at or below this ceiling. It does
# not alter strict assets or live promotion. 0 disables the filter.
SCALP_WINNER_SHADOW_MAX_REBOUND_PERCENT=0
# Correlated-entry safeguard candidate; 0 preserves the current multi-entry contract.
# A positive value caps strict entries sharing one completed-candle signal window.
SCALP_MAX_ENTRIES_PER_SIGNAL_WINDOW=0
# Fast independent ticker check for open-position stop/take/max-hold exits.
SCALP_RISK_CHECK_INTERVAL_MS=1000
# If an open position cannot receive a complete ticker risk check for this
# long, stop the paper/live loop and mark forward continuity invalid.
SCALP_MAX_RISK_DATA_GAP_SECONDS=30
# If a cycle cannot analyze every configured market for this long, stop the
# paper/live loop and invalidate forward continuity even when no position is open.
SCALP_MAX_ANALYSIS_DATA_GAP_SECONDS=60
SCALP_COOLDOWN_AFTER_LOSS_MINUTES=15
SCALP_MAX_CONSECUTIVE_LOSSES=3
# Optional process-wide loss circuit. 0 keeps it disabled.
# When enabled, N losses inside the window block every new strict/shadow entry
# for the cooldown period. Validate the setting separately before using live.
SCALP_LOSS_CIRCUIT_BREAKER_COUNT=0
SCALP_LOSS_CIRCUIT_BREAKER_WINDOW_MINUTES=30
SCALP_LOSS_CIRCUIT_BREAKER_COOLDOWN_MINUTES=60
SCALP_PAPER_MIN_DAYS=7
SCALP_PAPER_MIN_TRADES=20
SCALP_PAPER_MIN_RETURN_PERCENT=0.2
SCALP_PAPER_MAX_DRAWDOWN_PERCENT=15
SCALP_PAPER_MAX_HEARTBEAT_GAP_MINUTES=15
# Do not start/resume a forward ledger below this free-space margin.
SCALP_PAPER_MIN_STORAGE_MIB=1024
# Keep relaxed shadow books for filter diagnosis by default. Set false only
# for a separate strict-only forward session whose strict trades can be read
# as an isolated efficacy cohort; never change this on an active ledger.
SCALP_PAPER_DIAGNOSTIC_SHADOWS_ENABLED=true
SCALP_MAX_MARKETS=20
SCALP_MAX_POSITIONS=3
SCALP_PORTFOLIO_ALLOCATION=0.1
SCALP_INVESTMENT_RATIO=0.02
SCALP_STOP_LOSS_PERCENT=1.2
SCALP_TAKE_PROFIT_PERCENT=1.8
# Averaging is disabled by default for this strategy.
SCALP_ALLOW_AVERAGING=false
SCALP_REQUIRE_VALIDATION_PASS=true

# Forward paper runner (npm run paper:smoke). The default mode analyzes and
# stops; PAPER_FORWARD_MODE=true keeps a session open for the forward gate.
# PAPER_FORWARD_MODE=true
# PAPER_FORWARD_VERBOSE=false
# PAPER_SMOKE_SECONDS=60
# PAPER_SMOKE_INTERVAL_MS=5000
# PAPER_SMOKE_MAX_MARKETS=20
# PAPER_SMOKE_SEED_MONEY=1000000
# PAPER_SMOKE_OUTPUT_DIR=.paper-smoke
# Read-only summary of existing .paper-forward-* ledgers; never promotes or mutates them.
# PAPER_COHORT_ROOT=.
# PAPER_COHORT_OUTPUT_FILE=/tmp/coinpilot-paper-forward-cohort.json
# PAPER_EXIT_EVIDENCE_OUTPUT_FILE=/tmp/coinpilot-paper-exit-evidence.json
# PAPER_SMOKE_MARKETS also accepts a comma-separated explicit list, or
# FRESH_FROM_LEDGER (see below).

# Research-only forward cohort selection. Leave PAPER_SMOKE_MARKETS unset for
# the normal explicit list or top-volume selection. When set to
# FRESH_FROM_LEDGER, select only markets with enough observations and a low
# freshness-block rate from the prior isolated paper ledger; this does not
# change the default runtime universe or authorize live orders.
# PAPER_SMOKE_MARKETS=FRESH_FROM_LEDGER
# PAPER_SMOKE_FRESHNESS_LEDGER=.paper-forward-v44/paper_validation.json
# PAPER_SMOKE_MIN_FRESHNESS_OBSERVATIONS=100
# PAPER_SMOKE_MAX_STALE_RATE=0.05
# Dashboard/API also exposes a diagnostic recommendation using these limits;
# it never changes the active session's market list or live gate.
# SCALP_MARKET_QUALITY_MIN_OBSERVATIONS=100
# SCALP_MARKET_QUALITY_MAX_STALE_RATE=0.05
# Leave false/unset for normal runs. Setting true is only for explicitly
# separated diagnostic sessions and invalidates freshness/efficacy evidence.
# PAPER_ALLOW_CONCURRENT_SESSIONS=true

# Read-only historical validation
# Defaults: 1-minute candles, 7 days, top 3 non-stablecoin KRW markets.
SCALP_VALIDATION_CANDLE_COUNT=10080
SCALP_VALIDATION_MARKET_COUNT=3
# 0 evaluates the full deterministic tuning grid. A positive value is a
# research-only evenly spaced candidate sample and the report records both
# the full pool and the selected count.
# SCALP_VALIDATION_MAX_CANDIDATES=0
# Set true to validate the current runtime config without training-grid tuning.
# SCALP_VALIDATION_FIXED=true
# Training gate defaults: at least 3 trades, non-negative return, PF >= 1.
SCALP_VALIDATION_MIN_TRAINING_TRADES=3
SCALP_VALIDATION_MIN_TRAINING_PROFIT_FACTOR=1
SCALP_VALIDATION_MIN_TRAINING_RETURN_PERCENT=0
# Fixed validation additionally requires a one-sided 95% lower confidence
# bound for mean closed-trade return. Missing confidence metadata can never
# authorize live orders, even if an old report says promoted=true.
# SCALP_VALIDATION_REQUIRE_STATISTICAL_CONFIDENCE=true
SCALP_VALIDATION_MIN_TRAINING_CONFIDENCE_TRADES=10
SCALP_VALIDATION_MIN_CONFIDENCE_TRADES=20
SCALP_VALIDATION_MIN_CONFIDENCE_LOWER_PERCENT=0
# Set explicit markets when you want a fixed validation universe.
# SCALP_VALIDATION_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
# Optional reproducible raw cache: { "KRW-BTC": [ ... ] }. When set, every
# selected market must exist in the cache; validation never mixes in a fresh
# network window for a missing market.
# SCALP_VALIDATION_CANDLES_FILE=/tmp/coinpilot-candles.json
# Optional raw cache export for a validation run; keep it outside live-gate paths.
# SCALP_VALIDATION_CANDLES_OUTPUT_FILE=/tmp/coinpilot-validation-candles.json
# Optional authoritative config source: an active paper_validation.json with
# configSnapshotComplete=true. Recorded strategy/risk parameters override
# DEFAULT_CONFIG so validation cannot silently drift from a paper run. An
# explicitly supplied SCALP_VALIDATION_CANDLE_UNIT must match the snapshot.
# SCALP_VALIDATION_CONFIG_SNAPSHOT_FILE=.paper-forward-v73/paper_validation.json
# Upbit omits minute candles for intervals with no executions. This separate
# research-only lane can fill those intervals as previous-close/zero-volume
# rows while preserving the raw cache and blocking promotion unconditionally.
# It never writes scalping_validation.json.
# SCALP_NO_TRADE_FILL_CANDLES_FILE=/tmp/coinpilot-raw-candles.json
# SCALP_NO_TRADE_FILL_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
# SCALP_NO_TRADE_FILL_OUTPUT_FILE=/tmp/coinpilot-no-trade-fill.json
# Optional materialized filled cache for a separate research CLI. Keep this
# out of scalping_validation.json/live-gate paths.
# SCALP_NO_TRADE_FILL_CACHE_OUTPUT_FILE=/tmp/coinpilot-filled-candles.json
# Optional safety cap on filled intervals; unset means no cap.
# SCALP_NO_TRADE_FILL_MAX_INTERVALS=10000
# Optional unit override; falls back to the paper snapshot, then
# SCALP_CANDLE_UNIT (default 1).
# SCALP_NO_TRADE_FILL_CANDLE_UNIT=1
# SCALP_NO_TRADE_FILL_REQUIRE_STATISTICAL_CONFIDENCE=true

# Validation economics and window controls shared by the SCALP_VALIDATION_*
# lanes. Runtime tradingFee/slippage are fixed at 0.0005/0.001, so a report
# produced with non-default values fails closed at the live gate.
# SCALP_VALIDATION_CANDLE_UNIT=1
# SCALP_VALIDATION_INITIAL_BALANCE=1000000
# SCALP_VALIDATION_FEE=0.0005
# SCALP_VALIDATION_SLIPPAGE=0.001
# SCALP_VALIDATION_TRAIN_RATIO=0.7
# SCALP_VALIDATION_MIN_CANDLES=2000
# SCALP_VALIDATION_OUTPUT_FILE=scalping_validation.json
# Holdout promotion gates (fixed validation defaults).
# SCALP_VALIDATION_MIN_TRADES=10
# SCALP_VALIDATION_MIN_RETURN_PERCENT=0.1
# SCALP_VALIDATION_MIN_PROFIT_FACTOR=1.05
# SCALP_VALIDATION_MAX_DRAWDOWN=15
# Contiguous-segment diagnostic lane (requires a raw cache; promoted=false).
# SCALP_SEGMENT_CANDLES_FILE=/tmp/coinpilot-raw-candles.json
# SCALP_SEGMENT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
# Candle unit falls back to the paper snapshot, then SCALP_CANDLE_UNIT (=1).
# SCALP_SEGMENT_CANDLE_UNIT=1
# Unset/0 keeps the derived ~1.5-interval gap tolerance; set explicit seconds
# to override (90 below is only an example for 1-minute candles).
# SCALP_SEGMENT_MAX_GAP_SECONDS=90
# SCALP_SEGMENT_MIN_CANDLES=200
# SCALP_SEGMENT_OUTPUT_FILE=scalping_validation_segments.json
# Shared-portfolio diagnostic lane (one KRW balance, maxPositions enforced).
# SCALP_PORTFOLIO_VALIDATION_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
# SCALP_PORTFOLIO_VALIDATION_MARKET_COUNT=6
# Candle count falls back to SCALP_VALIDATION_CANDLE_COUNT (default 10080).
# SCALP_PORTFOLIO_VALIDATION_CANDLE_COUNT=10080
# 0 = single-window replay; >=2 enables the expanding multi-fold gate.
# SCALP_PORTFOLIO_VALIDATION_FOLDS=0
# SCALP_PORTFOLIO_VALIDATION_MIN_TRADES=10
# Set true to run the tuning grid per fold instead of the current config.
# SCALP_PORTFOLIO_VALIDATION_TUNED=false
# SCALP_PORTFOLIO_INITIAL_TRAIN_RATIO=0.5
# SCALP_PORTFOLIO_CANDLES_FILE=/tmp/coinpilot-portfolio-candles.json
# SCALP_PORTFOLIO_CANDLES_OUTPUT_FILE=/tmp/coinpilot-portfolio-candles-new.json
# SCALP_PORTFOLIO_VALIDATION_OUTPUT_FILE=scalping_portfolio_validation.json
# Same-window variant study (research-only; never writes the live-gate file).
# SCALP_VARIANT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
# SCALP_VARIANT_MARKET_COUNT=20
# Candle count falls back to SCALP_VALIDATION_CANDLE_COUNT (default 10080).
# SCALP_VARIANT_CANDLE_COUNT=10080
# Comma-separated variant names; unset runs the full study pool.
# SCALP_VARIANT_NAMES=
# SCALP_VARIANT_CANDLES_FILE=/tmp/coinpilot-variant-candles.json
# SCALP_VARIANT_CANDLES_OUTPUT_FILE=/tmp/coinpilot-variant-candles.json
# SCALP_VARIANT_OUTPUT_FILE=scalping_variant_study.json
# SCALP_VARIANT_REPORT_FILE=/private/tmp/coinpilot-scalping-variant-study.json
# Shared-snapshot forward A/B runner (research-only; DRY_RUN books only).
# The owner fetches each market ticker/candle once per cycle, then fans the
# exact snapshot out to independent virtual books. It never writes the live
# promotion report and never enables live orders.
# SCALP_FORWARD_VARIANT_NAMES=baseline,volume_15,rebound_25,max_rebound_04,loss_timeout_5m
# SCALP_FORWARD_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
# SCALP_FORWARD_VARIANT_MARKET_COUNT=3
# SCALP_FORWARD_VARIANT_SECONDS=60
# SCALP_FORWARD_VARIANT_MODE=true
# SCALP_FORWARD_VARIANT_INTERVAL_MS=5000
# SCALP_FORWARD_VARIANT_SEED_MONEY=1000000
# SCALP_FORWARD_VARIANT_OUTPUT_DIR=.paper-forward-variants/run-manual
# SCALP_FORWARD_VARIANT_RESET=false
# Winner-shadow candidate replay against a recorded paper session.
# SHADOW_VALIDATION_MARKET=KRW-KAT
# SHADOW_VALIDATION_CANDLES_FILE=/tmp/coinpilot-shadow-candles.json
# SHADOW_VALIDATION_OUTPUT_FILE=scalping_validation_shadow.json

# ============================================
# TARGET COINS
# ============================================
# Comma-separated list of coins to trade
# Use "ALL" to analyze all KRW market coins (230+)
# Examples:
#   TARGET_COINS=KRW-BTC,KRW-ETH,KRW-XRP
#   TARGET_COINS=ALL

TARGET_COINS=ALL
# Single-market tools only: backtest/optimize scripts and the dashboard
# backtest endpoint (default KRW-BTC). Not the multi-coin trading universe.
# TARGET_COIN=KRW-BTC

# ============================================
# PORTFOLIO SETTINGS
# ============================================
# Maximum number of simultaneous positions
MAX_POSITIONS=1000

# Maximum allocation per coin (0.3 = 30%)
PORTFOLIO_ALLOCATION=0.3

# Investment ratio per trade (0.05 = 5% of total assets)
INVESTMENT_RATIO=0.05

# ============================================
# DRY RUN SETTINGS
# ============================================
# Starting seed money for paper trading (KRW)
DRY_RUN_SEED_MONEY=10000000

# Check interval in milliseconds (30000 = 30 seconds)
# Applies to non-scalping dry runs; scalping mode uses a 5-second cycle.
CHECK_INTERVAL_DRY=30000

# ============================================
# LIVE TRADING SETTINGS
# ============================================
# Live check interval uses the shared CHECK_INTERVAL knob (see the legacy
# section; default 60000). There is no CHECK_INTERVAL_LIVE in the code, and
# scalping mode uses a 5-second cycle regardless.

# ============================================
# RISK MANAGEMENT
# ============================================
# Stop loss percentage (5 = 5%)
STOP_LOSS_PERCENT=5

# Take profit percentage (10 = 10%)
TAKE_PROFIT_PERCENT=10

# ============================================
# TECHNICAL INDICATORS
# ============================================
# RSI Settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Signal thresholds (higher = more conservative)
BUY_THRESHOLD=55
SELL_THRESHOLD=55

# Weight distribution (must sum to 1.0)
TECHNICAL_WEIGHT=0.6
NEWS_WEIGHT=0.4

# ============================================
# OPTIMIZATION SETTINGS
# ============================================
# (Not consumed by current code; the optimization window comes from
# BACKTEST_CANDLE_UNIT/BACKTEST_CANDLE_COUNT below.)
# OPTIMIZATION_DAYS=60

# Optimization interval (milliseconds)
# Live: 86400000 (24 hours)
# Dry:  21600000 (6 hours)
OPTIMIZATION_INTERVAL=86400000
OPTIMIZATION_INTERVAL_DRY=21600000

# Genetic algorithm settings
POPULATION_SIZE=20
GENERATIONS=10

# ============================================
# BACKTESTING SETTINGS
# ============================================
# Backtest interval in milliseconds (3600000 = 1 hour)
BACKTEST_INTERVAL=3600000

# (Not consumed by current code; backtest depth comes from
# BACKTEST_CANDLE_UNIT/BACKTEST_CANDLE_COUNT in the legacy section.)
# BACKTEST_DAYS=30

# ============================================
# SERVER SETTINGS
# ============================================
# Dashboard port (PORT is not consumed; DASHBOARD_PORT is the real knob)
DASHBOARD_PORT=3000
# Dashboard access token. Required for LAN/mobile access: when unset the
# dashboard refuses non-loopback binds and listens on 127.0.0.1 only.
# When set, every /api/* request must send `Authorization: Bearer <token>`
# and every Socket.io handshake must carry auth.token. The web UI stores the
# token in the browser's localStorage after the login gate.
DASHBOARD_TOKEN=
# Explicit bind host. Defaults: 0.0.0.0 when DASHBOARD_TOKEN is set,
# otherwise 127.0.0.1. A non-loopback host without a token is refused unless
# DASHBOARD_ALLOW_INSECURE=true (explicit opt-out, not recommended).
# LAN HTTP access is browser-only; PWA install/service worker require HTTPS
# (localhost/127.0.0.1 are allowed secure-context development exceptions).
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_ALLOW_INSECURE=false
# Extra cross-origin browser origins (comma-separated). Same-origin requests
# are always allowed; everything else is rejected before auth runs.
# DASHBOARD_CORS_ORIGINS=https://example.com
# Optional LAN HTTPS for installable PWA. Set both paths together; a partial
# pair fails closed instead of silently falling back to HTTP. Keep the private
# key outside Git. The certificate must be trusted by the mobile device.
# DASHBOARD_TLS_CERT_FILE=.secrets/dashboard/fullchain.pem
# DASHBOARD_TLS_KEY_FILE=.secrets/dashboard/privkey.pem

# ============================================
# AI ADVISOR / LONG-RUN MONITORING
# ============================================
# Read-only advice through locally authenticated subscription CLIs.
# GPT uses Codex CLI login; Claude uses Claude Code login.
# No provider API key is stored or passed by CoinPilot.
AI_ADVISOR_ENABLED=true
AI_ADVISOR_TIMEOUT_MS=60000
# Timeout 뒤 같은 provider child를 반복 생성하지 않는 cooldown.
# AI_PROVIDER_FAILURE_COOLDOWN_MS=30000
# Codex user-config parsing errors do not block the isolated app invocation.
AI_CODEX_IGNORE_USER_CONFIG=true
# When providers are unavailable, preserve a factual WAIT-only local brief.
AI_LOCAL_BRIEF_ENABLED=true
# Optional absolute/relative path for persistent sessions and consultations.
# AI_MONITORING_FILE=ai_monitoring_sessions.json
# Optional executable overrides when the CLIs are not on PATH.
# AI_CODEX_BIN=codex
# AI_CLAUDE_BIN=claude
# Optional model overrides; blank uses each CLI's configured default.
# AI_GPT_MODEL=
# AI_CLAUDE_MODEL=
# Evaluate completed provider advice against the first observed price at this horizon.
AI_EVALUATION_MINUTES=5
AI_EVALUATION_NEUTRAL_BAND_PERCENT=0.3
AI_EVALUATION_MIN_SAMPLES=20
# Optional: attach a real DRY_RUN paper smoke to an AI monitoring session.
# PAPER_AI_MONITORING=true
# PAPER_AI_PROVIDERS=gpt
# PAPER_AI_EVENTS=REBOUND_CANDIDATE,BUY_SIGNAL,SELL_SIGNAL
# PAPER_AI_AUTO_CONSULT_EVENTS=BUY_SIGNAL,SELL_SIGNAL
# PAPER_AI_COINS limits the monitor to these markets (default: session targets).
# PAPER_AI_COINS=KRW-BTC,KRW-ETH
# PAPER_AI_COOLDOWN_SECONDS=300
# PAPER_AI_SESSION_NAME=Paper AI efficacy monitoring
# PAPER_AI_HORIZON=short-term
# Unset inherits the AI_EVALUATION_* values above.
# PAPER_AI_EVALUATION_NEUTRAL_BAND_PERCENT=0.3
# PAPER_AI_EVALUATION_MIN_SAMPLES=20

# Isolated staging dashboard (npm run dashboard:staging).
# STAGING_OUTPUT_DIR=.staging-runtime/<run-id>
# STAGING_PORT=3100
# STAGING_TARGET_COINS=KRW-BTC,KRW-ETH
# STAGING_CHECK_INTERVAL_MS=60000

# Historical AI advice replay (npm run ai:replay; research-only).
# AI_REPLAY_CANDLES_FILE=.cap-study-candles.json
# AI_REPLAY_OUTPUT_FILE=/tmp/coinpilot-ai-historical-replay.json
# AI_REPLAY_PROVIDER=gpt
# AI_REPLAY_MAX_SAMPLES=20
# AI_REPLAY_HORIZON_CANDLES=5
# AI_REPLAY_MIN_SPACING_CANDLES=5
# AI_REPLAY_NEUTRAL_BAND_PERCENT=0.3
# AI_REPLAY_CONFIRMED_ONLY=false
# Comma-separated market filter; unset replays every market in the cache.
# AI_REPLAY_MARKETS=
# Cross-report robustness check (npm run ai:robustness). Reports come from
# CLI args or this comma-separated list.
# AI_ROBUSTNESS_REPORT_FILES=
# AI_ROBUSTNESS_MIN_NON_NEUTRAL=20
# AI_ROBUSTNESS_SCOPE=all
# AI_ROBUSTNESS_OUTPUT_FILE=
# Provider smoke selection (npm run ai:smoke).
# AI_SMOKE_PROVIDERS=both

# Read-only dashboard observer for an already-running forward paper ledger.
# This is intentionally not used by the normal dashboard smoke and must point
# to an explicitly selected isolated ledger. Start it with npm run dashboard:paper.
# PAPER_DASHBOARD_LEDGER_FILE=.paper-forward-v49/paper_validation.json
# DASHBOARD_PORT=3152

# Optional per-process portfolio history path. Staging/dashboard smoke uses an
# isolated path automatically; leave unset for the normal project history file.
# PORTFOLIO_HISTORY_FILE=portfolio_history.json
# Per-process ledger path overrides (defaults below; test runs auto-isolate to
# a temp dir regardless).
# DRY_PORTFOLIO_FILE=dry_portfolio.json
# PAPER_VALIDATION_FILE=paper_validation.json
# Internal test flag: forces isolated temp storage. Never set in real runs.
# NODE_TEST_CONTEXT=1

# Research-only higher-timeframe momentum lane. It never enables live orders or
# replaces scalping_validation.json. Supply a contiguous raw cache explicitly.
# SCALP_HTF_MOMENTUM_CANDLES_FILE=/tmp/coinpilot-60d-15m.json
# SCALP_HTF_MOMENTUM_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL
# SCALP_HTF_MOMENTUM_OUTPUT_FILE=/tmp/coinpilot-htf-momentum.json
# Optional diagnostic-only fill for short Upbit no-trade gaps. Default false;
# filled caches are synthetic and never promotion/live evidence.
# SCALP_HTF_MOMENTUM_FILL_NO_TRADE=false
# SCALP_HTF_MOMENTUM_MAX_FILL_INTERVALS=4
# Cache fetcher depth for the HTF lane (default 8000, minimum 200).
# SCALP_HTF_MOMENTUM_CANDLE_COUNT=8000
# SCALP_HTF_BASE_CANDLE_UNIT=15
# SCALP_HTF_FOLDS=3
# Fold/gate tuning (all research-only; promoted is always false).
# SCALP_HTF_MIN_TRAINING_FRACTION=0.5
# SCALP_HTF_VALIDATION_FRACTION=0.15
# SCALP_HTF_MIN_TRAINING_TRADES=3
# SCALP_HTF_MIN_VALIDATION_TRADES=5
# SCALP_HTF_MIN_TRAINING_PF=1
# SCALP_HTF_MIN_VALIDATION_PF=1.05
# SCALP_HTF_MIN_TRAINING_RETURN=0
# SCALP_HTF_MIN_VALIDATION_RETURN=0.1
# SCALP_HTF_MAX_DRAWDOWN=15
# SCALP_HTF_MIN_CONFIDENCE_LOWER=0
# Shared-portfolio replay overrides (defaults come from each variant: 4 / 0.25).
# SCALP_HTF_MAX_POSITIONS=4
# SCALP_HTF_PORTFOLIO_POSITION_FRACTION=0.25
# Read-only dashboard research projection reads this report first, then
# SCALP_HTF_MOMENTUM_OUTPUT_FILE.
# SCALP_HTF_MOMENTUM_REPORT_FILE=

# Research-only daily momentum and synthetic market-neutral lanes.
# The fetcher writes only a cache; the validators never change runtime/live
# settings. The synthetic short leg is not connected to Upbit spot execution.
# DAILY_MOMENTUM_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE,KRW-ADA,KRW-DOT,KRW-LINK,KRW-ATOM,KRW-NEAR,KRW-ETC,KRW-SUI
# DAILY_MOMENTUM_DAYS=400
# Segment/economics knobs for the variant sweep.
# DAILY_MOMENTUM_SEGMENTS=4
# DAILY_MOMENTUM_INITIAL_BALANCE=100000000
# DAILY_MOMENTUM_COST_PERCENT=0.2
# DAILY_MOMENTUM_POSITION_FRACTION=0.25
# DAILY_MOMENTUM_MAX_POSITIONS=4
# DAILY_MOMENTUM_CANDLES_FILE=/private/tmp/coinpilot-daily-momentum-candles.json
# DAILY_MOMENTUM_REPORT_FILE=/private/tmp/coinpilot-daily-momentum-report.json
# DAILY_MOMENTUM_ROBUSTNESS_REPORT_FILE=/private/tmp/coinpilot-daily-momentum-robustness-report.json
# DAILY_MOMENTUM_ROBUSTNESS_SEGMENTS=8
# DAILY_MOMENTUM_ROBUSTNESS_SEGMENT_MODE=continuous
# Grid axes for the robustness sweep; unset uses each default axis.
# DAILY_MOMENTUM_ROBUSTNESS_MODES=regime
# DAILY_MOMENTUM_ROBUSTNESS_MAX_HOLD_DAYS=3650
# DAILY_MOMENTUM_ROBUSTNESS_TREND_MIN_PERCENT=1,2
# DAILY_MOMENTUM_ROBUSTNESS_BREADTH_MIN=2,3
# DAILY_MOMENTUM_ROBUSTNESS_POSITION_FRACTION=0.125,0.2,0.25
# DAILY_MOMENTUM_ROBUSTNESS_MAX_POSITIONS=2,3,4
# DAILY_MOMENTUM_ROBUSTNESS_COOLDOWN_AFTER_LOSS_DAYS=0,3
# DAILY_MOMENTUM_ROBUSTNESS_MAX_PORTFOLIO_DRAWDOWN_PERCENT=0,10,15
# DAILY_MOMENTUM_ROBUSTNESS_BENCHMARK_THRESHOLDS=0,1,2
# DAILY_MOMENTUM_ROBUSTNESS_MIN_UP_BARS=1,2
# DAILY_MOMENTUM_ROBUSTNESS_VOLATILITY_LOOKBACK_DAYS=7,14,21,28
# DAILY_MOMENTUM_ROBUSTNESS_VOLATILITY_TARGET_PERCENT=0.75,1,1.25
# DAILY_MOMENTUM_ROBUSTNESS_STOP_LOSS_PERCENT=0,1,2,3,5,7
# DAILY_MOMENTUM_ROBUSTNESS_MAX_ENTRY_GAP_PERCENT=0,0.1,0.2,0.3
# DAILY_MOMENTUM_ROBUSTNESS_ENTRY_EXECUTION=next_open
# DAILY_MOMENTUM_ROBUSTNESS_EXIT_EXECUTION=next_open
# Comma-separated confirmation-bar axes; unset keeps each axis unswept.
# DAILY_MOMENTUM_ROBUSTNESS_BENCHMARK_EXIT_CONFIRMATION_BARS=
# DAILY_MOMENTUM_ROBUSTNESS_REGIME_EXIT_CONFIRMATION_BARS=
# Comma-separated axis for relative trend gates; unset keeps it unswept.
# DAILY_MOMENTUM_ROBUSTNESS_RELATIVE_TREND_MIN_PERCENT=
# DAILY_MOMENTUM_ROBUSTNESS_COST_PERCENT=0.3
# DAILY_MOMENTUM_ROBUSTNESS_MIN_RETURN_PERCENT=0
# DAILY_MOMENTUM_ROBUSTNESS_MAX_DRAWDOWN_PERCENT=15
# DAILY_MOMENTUM_ROBUSTNESS_MIN_WORST_SEGMENT_PERCENT=-2
# DAILY_MOMENTUM_ROBUSTNESS_MIN_TRADES=30
# Trailing-window read-only stability study; a requested window is never
# shortened when the cache has insufficient history.
# DAILY_MOMENTUM_ROLLING_CANDLES_FILE=/private/tmp/coinpilot-daily-momentum-candles-v3-800d.json
# DAILY_MOMENTUM_ROLLING_REPORT_FILE=/private/tmp/coinpilot-daily-momentum-rolling-report.json
# Unset uses every market present in the cache.
# DAILY_MOMENTUM_ROLLING_MARKETS=
# DAILY_MOMENTUM_ROLLING_WINDOWS=120,180,240,300,365,400,500,600,800
# DAILY_MOMENTUM_ROLLING_MIN_TRADES=30
# DAILY_MOMENTUM_ROLLING_CONFIG_JSON=
# Benchmark-confirmation study (validateDailyMomentumBenchmarkConfirmation.js).
# Entry/exit execution model: default 'close'; 'next_open' simulates
# next-candle-open fills.
# DAILY_MOMENTUM_ENTRY_EXECUTION=close
# DAILY_MOMENTUM_EXIT_EXECUTION=close
# Optional benchmark exposure bounds; unset applies no bound (examples below).
# DAILY_MOMENTUM_BENCHMARK_EXPOSURE_MIN_PERCENT=-5
# DAILY_MOMENTUM_BENCHMARK_EXPOSURE_MAX_PERCENT=5
# DAILY_MARKET_NEUTRAL_CANDLES_FILE=/private/tmp/coinpilot-daily-momentum-candles.json
# DAILY_MARKET_NEUTRAL_REPORT_FILE=/private/tmp/coinpilot-daily-market-neutral-report.json
# Unset markets default to every market in the cache.
# DAILY_MARKET_NEUTRAL_MARKETS=KRW-BTC,KRW-ETH
# DAILY_MARKET_NEUTRAL_SEGMENTS=4
# DAILY_MARKET_NEUTRAL_INITIAL_BALANCE=100000000
# DAILY_MARKET_NEUTRAL_LONG_EXPOSURE=0.4
# DAILY_MARKET_NEUTRAL_SHORT_EXPOSURE=0.4
# DAILY_MARKET_NEUTRAL_COST_PERCENT=0.2
# DAILY_MARKET_NEUTRAL_SHORT_BORROW_COST_PER_DAY=0
# (No env override: the portfolio drawdown axis lives in the robustness grid
# and the MOMO_SHADOW_* candidate contract, not the daily variants lane.)
# Optional separate benchmark-gated daily shadow candidate. Values below are
# the shared candidate contract used by preflight, the launcher, and the
# read-only API. The raw runner (runRegimeMomentumShadow.js) accepts the same
# names with simpler defaults: mode=fixed, markets=BTC/ETH/XRP/SOL,
# pollMs=300000, trendMin=0, breadthMin=1, minUpBars=1, positionFraction=0.25,
# maxPositions=4.
# MOMO_SHADOW_DIR=.paper-momentum-shadow-v1
# MOMO_SHADOW_MODE=regime
# MOMO_SHADOW_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE,KRW-ADA,KRW-DOT,KRW-LINK,KRW-ATOM,KRW-NEAR,KRW-ETC,KRW-SUI
# MOMO_SHADOW_BENCHMARK_MARKET=KRW-BTC
# MOMO_SHADOW_BENCHMARK_TREND_MIN_PERCENT=2
# Optional relative-strength guard for a separately isolated A/B owner. A
# value of 0 requires each asset trend to be strictly above the benchmark;
# missing benchmark trend data fails closed. Keep unset for the existing books.
# MOMO_SHADOW_RELATIVE_TREND_MIN_PERCENT=0
# MOMO_SHADOW_EXIT_ON_BENCHMARK_OFF=true
# MOMO_SHADOW_INITIAL_BALANCE=100000000
# MOMO_SHADOW_COST_PERCENT=0.2
# MOMO_SHADOW_TREND_MIN_PERCENT=2
# MOMO_SHADOW_BREADTH_MIN=2
# MOMO_SHADOW_POSITION_FRACTION=0.125
# MOMO_SHADOW_MAX_POSITIONS=2
# Research-only/forward A-B volatility sizing overlay; a fresh book with an
# unset target keeps the legacy fixed position size, while an existing book
# inherits its persisted target/lookback on relaunch like the other risk
# knobs. A target of 1 is a separate candidate contract.
# MOMO_SHADOW_VOLATILITY_LOOKBACK_DAYS=14
# MOMO_SHADOW_VOLATILITY_TARGET_PERCENT=1
# MOMO_SHADOW_ENTRY_EXECUTION=next_open
# Keep the default candle-close paper contract unless a separately isolated
# research owner explicitly opts into best-ask entry / best-bid exit+mark.
# MOMO_SHADOW_EXECUTION_MODEL=candle_close
# Separate fixed two-day exit A/B candidate; keep its ledger isolated from
# the existing 72-hour fixed and regime books. Candidate env overrides are
# per-launch contracts: export only the set for the candidate being started,
# since one process's env applies to every candidate it touches.
# MOMO_SHADOW_FIXED_HOLD_DIR=.paper-momentum-shadow-fixed-hold-2d-v1
# MOMO_SHADOW_MODE=fixed
# MOMO_SHADOW_MAX_HOLD_HOURS=48
# Separate loss-cap A/B of the fixed two-day candidate. This is a completed
# daily-close stop hypothesis, not an intraday fill guarantee or promotion.
# MOMO_SHADOW_FIXED_HOLD_LOSS_CAP_DIR=.paper-momentum-shadow-fixed-hold-2d-loss-cap-v1
# Separate loss-cap A/B with DOGE excluded, matching the 400/800-day
# market-filter SHADOW_CANDIDATE study. It remains research-only.
# MOMO_SHADOW_FIXED_HOLD_LOSS_CAP_NO_DOGE_DIR=.paper-momentum-shadow-fixed-hold-2d-loss-cap-no-doge-v1
# MOMO_SHADOW_STOP_LOSS_PERCENT=4
# Separate quote-quality A/B of the fixed two-day candidate. It blocks only
# markets whose best bid/ask spread exceeds the configured ceiling; a
# missing/invalid orderbook response blocks all new entries for that cycle.
# MOMO_SHADOW_FIXED_HOLD_SPREAD_DIR=.paper-momentum-shadow-fixed-hold-2d-spread-v1
# MOMO_SHADOW_MAX_SPREAD_PERCENT=0.5
# MOMO_SHADOW_FIXED_HOLD_RELATIVE_DIR=.paper-momentum-shadow-fixed-hold-2d-relative-v1
# Quote-cross execution A/B: pair this ledger with MOMO_SHADOW_EXECUTION_MODEL=quote_cross.
# MOMO_SHADOW_FIXED_HOLD_QUOTE_CROSS_DIR=.paper-momentum-shadow-fixed-hold-2d-quote-cross-v1
# Shared request pacing when multiple shadow owners use the public API.
# MOMO_SHADOW_REQUEST_INTERVAL_MS=500
# Stop a shadow cycle after this many consecutive daily-fetch failures. The
# cycle remains fail-closed and retries on the next poll; strategy state is not
# changed by this operational network circuit breaker.
# MOMO_SHADOW_MAX_CONSECUTIVE_FETCH_FAILURES=3
# Maximum wall-clock time for one daily-fetch/decision cycle. A timeout stops
# the owner fail-closed and lets the next supervised restart retry the cycle.
# MOMO_SHADOW_MAX_CYCLE_DURATION_MS=600000
# Read-only repeated best-bid/ask snapshot; no orders are sent.
# MOMO_SHADOW_QUOTE_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE,KRW-ADA,KRW-DOT,KRW-LINK,KRW-ATOM,KRW-NEAR,KRW-ETC,KRW-SUI
# MOMO_SHADOW_QUOTE_SAMPLES=5
# MOMO_SHADOW_QUOTE_INTERVAL_MS=2000
# MOMO_SHADOW_QUOTE_MAX_SPREAD_PERCENT=0.5
# Maximum age accepted when the read-only quote report is shown as current.
# This is UI/readback freshness only; the runner fetches its own quote per cycle.
# MOMO_SHADOW_QUOTE_MAX_AGE_SECONDS=900
# Persistent ignored runtime directory for quote report/history. The default
# is .coinpilot-runtime/momentum-shadow so session cleanup does not erase the
# append-only evidence window.
# MOMO_SHADOW_RUNTIME_DIR=.coinpilot-runtime/momentum-shadow
# MOMO_SHADOW_QUOTE_REPORT_FILE=.coinpilot-runtime/momentum-shadow/quote-quality.json
# MOMO_SHADOW_QUOTE_HISTORY_FILE=.coinpilot-runtime/momentum-shadow/quote-history.jsonl
# Read-only comparison of target-market p95 quote spread against the scalping
# model's per-side adverse-slippage budget. It never authorizes an order.
# SCALP_QUOTE_COMPATIBILITY_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL
# SCALP_QUOTE_COMPATIBILITY_MIN_SAMPLES=5
# SCALP_QUOTE_COMPATIBILITY_MAX_AGE_SECONDS=900
# SCALP_QUOTE_COMPATIBILITY_OUTPUT_FILE=/private/tmp/coinpilot-quote-cost-compatibility.json
# Append-only local live order/fill evidence. No API keys are written. A write
# failure blocks subsequent live orders until the process is restarted/fixed.
# LIVE_EXECUTION_EVIDENCE_FILE=.coinpilot-runtime/live-execution/evidence.jsonl
# Browser-exported read-only evidence snapshot verifier input. If unset, the
# verifier uses /private/tmp/coinpilot-momentum-shadow-evidence-current.json.
# This command never reads or mutates the live ledger; it only checks JSON.
# MOMO_SHADOW_EVIDENCE_SNAPSHOT_FILE=/path/to/coinpilot-momentum-shadow-evidence.json
# Maximum snapshot age accepted as fresh by the verifier (seconds).
# MOMO_SHADOW_EVIDENCE_MAX_AGE_SECONDS=900
# Minimum observation period shown by the read-only promotion diagnostic.
# This does not authorize orders or alter the shadow runner.
# MOMO_SHADOW_MIN_RESEARCH_DAYS=14
# Separate cost-robust next-open diagnostic candidate (gate 1%, breadth 3,
# volatility target 1%, cost 0.3%, adverse gap ceiling 0.2%); keep its target
# isolated from close books.
# MOMO_SHADOW_NEXT_OPEN_DIR=.paper-momentum-shadow-next-open-v1
# Raw-runner exit overrides: fixed mode caps at 72h, regime mode at ~1y.
# MOMO_SHADOW_MAX_HOLD_HOURS=72
# MOMO_SHADOW_STOP_LOSS_PERCENT=0
# MOMO_SHADOW_TAKE_PROFIT_PERCENT=0
# ntfy.sh topic for shadow event pushes; unset disables notifications.
# MOMO_SHADOW_NTFY_TOPIC=
# Optional risk-envelope contract for a separate candidate owner. These fields
# are omitted when unset so old ledgers do not acquire artificial config drift.
# MOMO_SHADOW_COOLDOWN_AFTER_LOSS_DAYS=3
# MOMO_SHADOW_MAX_PORTFOLIO_DRAWDOWN_PERCENT=15
# MOMO_SHADOW_MAX_ENTRY_GAP_PERCENT=0.2
# Freshness is measured from the completed bar's end boundary, so the newest
# completed daily candle stays fresh for a full UTC day before flagging.
# MOMO_SHADOW_MAX_DAILY_CANDLE_AGE_HOURS=36
# MOMO_SHADOW_MIN_UP_BARS=2
# MOMO_SHADOW_POLL_MS=900000
# MOMO_SHADOW_CANDIDATE_DIR=.paper-momentum-shadow-btc-gate-v2
# Use the same sealed candidate profile for both read-only preflight and the
# detached launcher. Omit for baseline; set exactly one profile per command.
# MOMO_SHADOW_CANDIDATE_PROFILE=quote_cross
# MOMO_SHADOW_CANDIDATE_PROFILE=loss_cap
# MOMO_SHADOW_CANDIDATE_PROFILE=loss_cap_no_doge
# One global slot shared by candidate launchers; only one candidate owner may
# run at a time. Existing fixed/regime/benchmark owners do not use this slot.
# MOMO_SHADOW_CANDIDATE_SLOT_FILE=.paper-momentum-shadow-candidate.lock
# MOMO_SHADOW_VOLATILITY_DIR=.paper-momentum-shadow-vol-target-v1
# MOMO_SHADOW_BENCHMARK_DIR=.paper-momentum-shadow-btc-gate-v1
# MOMO_SHADOW_FIXED_DIR=.paper-momentum-shadow-v1
# MOMO_SHADOW_REGIME_DIR=.paper-momentum-shadow-regime
# Comma-separated ledger dirs treated as owners in readiness checks; default
# is every known book above (fixed, regime, benchmark, volatility, next-open,
# and the fixed-hold/spread/relative/quote-cross candidates).
# MOMO_SHADOW_OWNER_DIRS=
# MOMO_SHADOW_MIN_POLL_MS=900000
# MOMO_SHADOW_REQUIRE_BENCHMARK_OPEN=true
# MOMO_SHADOW_ALLOW_START=false

# Regime-momentum historical validator (research-only; fails closed without a
# cache). Consumed by src/scripts/validateRegimeMomentum.js.
# REGIME_CANDLES_FILE=/tmp/coinpilot-regime-candles.json
# REGIME_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL
# REGIME_SOURCE_UNIT_MINUTES=15
# REGIME_SIGNAL_UNIT_MINUTES=60
# REGIME_RSI_PERIOD=14
# REGIME_RSI_THRESHOLD=65
# REGIME_TREND_LOOKBACK_HOURS=168
# REGIME_REQUIRE_UP_BAR=true
# REGIME_MAX_HOLD_HOURS=48
# REGIME_STOP_LOSS_PERCENT=0
# REGIME_TAKE_PROFIT_PERCENT=0
# REGIME_MAX_POSITIONS=4
# REGIME_POSITION_FRACTION=0.25
# REGIME_INITIAL_BALANCE=100000000
# REGIME_COST_PERCENT=0.2
# REGIME_TRAIN_FRACTION=0.6
# REGIME_MAX_GAP_INTERVALS=1.5
# REGIME_REPORT_FILE=

# PAPER_AI_EVALUATION_MINUTES=5
# PAPER_AI_STOP_WAIT_MS=35000
# PAPER_AI_MONITORING_FILE=.paper-smoke/ai_monitoring_sessions.json

# ============================================
# LEGACY / NON-SCALPING MODES
# ============================================
# Only consumed when TRADING_STRATEGY selects a non-scalping mode or by the
# legacy entry/GA/backtest tools. None of these affect the scalping contract.
# Generic fallbacks read by index.js after the SCALP_* names.
# CANDLE_UNIT=5
# CANDLE_COUNT=200
# CHECK_INTERVAL=60000
# ENABLE_DASHBOARD=true
# Dynamic investment sizing (legacy modes).
# INVESTMENT_AMOUNT=50000
# MIN_INVESTMENT_AMOUNT=5000
# MAX_INVESTMENT_AMOUNT=500000
# USE_PROPORTIONAL_INVESTMENT=true
# Live-mode initial equity anchor; 0 derives it automatically.
# INITIAL_SEED_MONEY=0
# ALLOW_AVERAGING=true
# BUY_ONLY=false
# NEWS_CHECK_INTERVAL=300000
# NEWS_SENTIMENT_THRESHOLD=0.5
# Legacy indicator knobs (EMA_SHORT/MID, MACD, volume, trailing).
# EMA_SHORT=10
# EMA_MID=30
# MACD_FAST=12
# MACD_SLOW=26
# MACD_SIGNAL=9
# TRAILING_STOP_PERCENT=3
# VOLUME_PERIOD=20
# VOLUME_MULTIPLIER=1.5
# Genetic-algorithm optimizer / legacy backtest lane.
# CROSSOVER_RATE=0.7
# MUTATION_RATE=0.2
# ELITE_SIZE=2
# BACKTEST_CANDLE_UNIT=15
# BACKTEST_CANDLE_COUNT=500

# ============================================
# LOGGING
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
