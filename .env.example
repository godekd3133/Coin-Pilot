# ============================================
# Coin Pilot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# UPBIT API CREDENTIALS (Required for trading)
# ============================================
# Get your API keys from: https://upbit.com/mypage/open_api_management
# WARNING: Never commit your actual API keys to version control!

UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here
# Read-only/order HTTP timeout. Prevents a hung Upbit socket from stopping a paper cycle forever.
UPBIT_REQUEST_TIMEOUT_MS=10000

# ============================================
# TRADING MODE
# ============================================
# true  = Paper trading (simulated, no real money)
# false = Live trading (real money, use with caution!)

DRY_RUN=true

# ============================================
# STRATEGY: OVERSOLD REACTION SCALPING
# ============================================
# The default strategy waits for a completed 1-minute candle to confirm
# an oversold rebound, then re-checks the market after a 1-5 second delay.
TRADING_STRATEGY=oversold_reaction_scalping
SCALP_CANDLE_UNIT=1
SCALP_RSI_PERIOD=14
SCALP_RSI_OVERSOLD=30
SCALP_RSI_OVERBOUGHT=70
SCALP_OVERSOLD_LOOKBACK=1
SCALP_CANDLE_COUNT=120
# Maximum age of the newest candle allowed at entry. 0 uses an adaptive
# candle-unit default (90 seconds for 1-minute candles).
SCALP_MAX_CANDLE_AGE_SECONDS=0
SCALP_MIN_REBOUND_PERCENT=0.15
SCALP_MIN_RSI_RECOVERY=2
SCALP_MIN_VOLUME_RATIO=1.0
SCALP_VOLUME_LOOKBACK=20
SCALP_MIN_CLOSE_STRENGTH=0.65
SCALP_TREND_PERIOD=30
SCALP_TREND_SLOPE_LOOKBACK=3
SCALP_MIN_TREND_SLOPE_PERCENT=-0.2
SCALP_REQUIRE_PREVIOUS_HIGH_BREAK=true
# 0 disables the signal-candle volatility guard. Test non-zero values in holdout first.
SCALP_MAX_SIGNAL_RANGE_PERCENT=0
# 0 disables the minimum signal-candle movement floor. Validate non-zero values first.
SCALP_MIN_SIGNAL_RANGE_PERCENT=0
# Optional portfolio-wide regime filter. Keep disabled until a multi-market
# holdout confirms it improves the shared portfolio, not just trade count.
SCALP_MARKET_REGIME_ENABLED=false
SCALP_MARKET_REGIME_LOOKBACK=5
SCALP_MARKET_REGIME_MIN_BREADTH=0.5
SCALP_MARKET_REGIME_MIN_RETURN_PERCENT=-0.2
# Portfolio diagnostic only: wait for next candle bullish close before entry.
SCALP_PORTFOLIO_REQUIRE_NEXT_CANDLE_BULLISH=false
SCALP_SIGNAL_PROFILE=rsi_rebound
SCALP_ENTRY_DELAY_MIN_MS=1000
SCALP_ENTRY_DELAY_MAX_MS=5000
SCALP_MAX_ENTRY_RETRACE_PERCENT=0.25
SCALP_MAX_ENTRY_CHASE_PERCENT=0.35
# Optional protective exits. Zero activation keeps the fixed stop/take model.
# Enable only after a separate historical holdout and forward shadow study.
SCALP_BREAK_EVEN_TRIGGER_PERCENT=0
SCALP_BREAK_EVEN_OFFSET_PERCENT=0.05
SCALP_TRAILING_ACTIVATION_PERCENT=0
SCALP_TRAILING_STOP_PERCENT=0
SCALP_MAX_HOLD_MINUTES=30
# Loss-only early exit candidate; 0 preserves the fixed max-hold contract.
SCALP_MAX_LOSING_HOLD_MINUTES=0
# Correlated-entry safeguard candidate; 0 preserves the current multi-entry contract.
# A positive value caps strict entries sharing one completed-candle signal window.
SCALP_MAX_ENTRIES_PER_SIGNAL_WINDOW=0
# Fast independent ticker check for open-position stop/take/max-hold exits.
SCALP_RISK_CHECK_INTERVAL_MS=1000
# If an open position cannot receive a complete ticker risk check for this
# long, stop the paper/live loop and mark forward continuity invalid.
SCALP_MAX_RISK_DATA_GAP_SECONDS=30
SCALP_COOLDOWN_AFTER_LOSS_MINUTES=15
SCALP_MAX_CONSECUTIVE_LOSSES=3
# Optional process-wide loss circuit. 0 keeps it disabled.
# When enabled, N losses inside the window block every new strict/shadow entry
# for the cooldown period. Validate the setting separately before using live.
SCALP_LOSS_CIRCUIT_BREAKER_COUNT=0
SCALP_LOSS_CIRCUIT_BREAKER_WINDOW_MINUTES=30
SCALP_LOSS_CIRCUIT_BREAKER_COOLDOWN_MINUTES=60
SCALP_PAPER_MIN_DAYS=7
SCALP_PAPER_MIN_TRADES=20
SCALP_PAPER_MIN_RETURN_PERCENT=0.2
SCALP_PAPER_MAX_DRAWDOWN_PERCENT=15
SCALP_PAPER_MAX_HEARTBEAT_GAP_MINUTES=15
# Do not start/resume a forward ledger below this free-space margin.
SCALP_PAPER_MIN_STORAGE_MIB=1024
SCALP_MAX_MARKETS=20
SCALP_MAX_POSITIONS=3
SCALP_PORTFOLIO_ALLOCATION=0.1
SCALP_INVESTMENT_RATIO=0.02
SCALP_STOP_LOSS_PERCENT=1.2
SCALP_TAKE_PROFIT_PERCENT=1.8
# Averaging is disabled by default for this strategy.
SCALP_ALLOW_AVERAGING=false
SCALP_REQUIRE_VALIDATION_PASS=true

# Research-only forward cohort selection. Leave PAPER_SMOKE_MARKETS unset for
# the normal explicit list or top-volume selection. When set to
# FRESH_FROM_LEDGER, select only markets with enough observations and a low
# freshness-block rate from the prior isolated paper ledger; this does not
# change the default runtime universe or authorize live orders.
# PAPER_SMOKE_MARKETS=FRESH_FROM_LEDGER
# PAPER_SMOKE_FRESHNESS_LEDGER=.paper-forward-v44/paper_validation.json
# PAPER_SMOKE_MIN_FRESHNESS_OBSERVATIONS=100
# PAPER_SMOKE_MAX_STALE_RATE=0.05

# Read-only historical validation
# Defaults: 1-minute candles, 7 days, top 3 non-stablecoin KRW markets.
SCALP_VALIDATION_CANDLE_COUNT=10080
SCALP_VALIDATION_MARKET_COUNT=3
# Set true to validate the current runtime config without training-grid tuning.
# SCALP_VALIDATION_FIXED=true
# Training gate defaults: at least 3 trades, non-negative return, PF >= 1.
SCALP_VALIDATION_MIN_TRAINING_TRADES=3
SCALP_VALIDATION_MIN_TRAINING_PROFIT_FACTOR=1
SCALP_VALIDATION_MIN_TRAINING_RETURN_PERCENT=0
# Set explicit markets when you want a fixed validation universe.
# SCALP_VALIDATION_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP

# ============================================
# TARGET COINS
# ============================================
# Comma-separated list of coins to trade
# Use "ALL" to analyze all KRW market coins (230+)
# Examples:
#   TARGET_COINS=KRW-BTC,KRW-ETH,KRW-XRP
#   TARGET_COINS=ALL

TARGET_COINS=ALL

# ============================================
# PORTFOLIO SETTINGS
# ============================================
# Maximum number of simultaneous positions
MAX_POSITIONS=1000

# Maximum allocation per coin (0.3 = 30%)
PORTFOLIO_ALLOCATION=0.3

# Investment ratio per trade (0.05 = 5% of total assets)
INVESTMENT_RATIO=0.05

# ============================================
# DRY RUN SETTINGS
# ============================================
# Starting seed money for paper trading (KRW)
DRY_RUN_SEED_MONEY=10000000

# Check interval in milliseconds (30000 = 30 seconds)
CHECK_INTERVAL_DRY=30000

# ============================================
# LIVE TRADING SETTINGS
# ============================================
# Check interval for live trading (60000 = 1 minute)
CHECK_INTERVAL_LIVE=60000

# ============================================
# RISK MANAGEMENT
# ============================================
# Stop loss percentage (5 = 5%)
STOP_LOSS_PERCENT=5

# Take profit percentage (10 = 10%)
TAKE_PROFIT_PERCENT=10

# ============================================
# TECHNICAL INDICATORS
# ============================================
# RSI Settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Signal thresholds (higher = more conservative)
BUY_THRESHOLD=55
SELL_THRESHOLD=55

# Weight distribution (must sum to 1.0)
TECHNICAL_WEIGHT=0.6
NEWS_WEIGHT=0.4

# ============================================
# OPTIMIZATION SETTINGS
# ============================================
# Days of historical data for optimization
OPTIMIZATION_DAYS=60

# Optimization interval (milliseconds)
# Live: 86400000 (24 hours)
# Dry:  21600000 (6 hours)
OPTIMIZATION_INTERVAL=86400000
OPTIMIZATION_INTERVAL_DRY=21600000

# Genetic algorithm settings
POPULATION_SIZE=20
GENERATIONS=10

# ============================================
# BACKTESTING SETTINGS
# ============================================
# Backtest interval in milliseconds (3600000 = 1 hour)
BACKTEST_INTERVAL=3600000

# Days of data for backtesting
BACKTEST_DAYS=30

# ============================================
# SERVER SETTINGS
# ============================================
# Dashboard port
PORT=3000

# ============================================
# AI ADVISOR / LONG-RUN MONITORING
# ============================================
# Read-only advice through locally authenticated subscription CLIs.
# GPT uses Codex CLI login; Claude uses Claude Code login.
# No provider API key is stored or passed by CoinPilot.
AI_ADVISOR_ENABLED=true
AI_ADVISOR_TIMEOUT_MS=30000
# Codex user-config parsing errors do not block the isolated app invocation.
AI_CODEX_IGNORE_USER_CONFIG=true
# When providers are unavailable, preserve a factual WAIT-only local brief.
AI_LOCAL_BRIEF_ENABLED=true
# Optional absolute/relative path for persistent sessions and consultations.
# AI_MONITORING_FILE=ai_monitoring_sessions.json
# Optional executable overrides when the CLIs are not on PATH.
# AI_CODEX_BIN=codex
# AI_CLAUDE_BIN=claude
# Optional model overrides; blank uses each CLI's configured default.
# AI_GPT_MODEL=
# AI_CLAUDE_MODEL=
# Evaluate completed provider advice against the first observed price at this horizon.
AI_EVALUATION_MINUTES=5
AI_EVALUATION_NEUTRAL_BAND_PERCENT=0.1
AI_EVALUATION_MIN_SAMPLES=20
# Optional: attach a real DRY_RUN paper smoke to an AI monitoring session.
# PAPER_AI_MONITORING=true
# PAPER_AI_PROVIDERS=gpt
# PAPER_AI_EVENTS=BUY_SIGNAL,SELL_SIGNAL
# PAPER_AI_EVALUATION_MINUTES=5
# PAPER_AI_STOP_WAIT_MS=35000
# PAPER_AI_MONITORING_FILE=.paper-smoke/ai_monitoring_sessions.json

# ============================================
# LOGGING
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
