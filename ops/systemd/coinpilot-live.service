[Unit]
Description=CoinPilot LIVE account service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/lib/coinpilot-live
EnvironmentFile=/etc/coinpilot/coinpilot-live.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/coinpilot-live/current/src/index.js
Restart=on-failure
RestartSec=5s
# LIVE shutdown may stay in protective-only mode until positions are flat and
# exchange state is verified. Do not let a wall-clock timeout SIGKILL that monitor.
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/coinpilot-live

[Install]
WantedBy=multi-user.target
