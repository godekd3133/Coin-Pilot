NODE_ENV=production
# nano(0.5GB) 호스트에 Paper와 공존하므로 힙 상한을 보수적으로 잡는다.
# Paper는 256MB를 사용 중; Micro(1GB) 이상으로 리사이즈하면 256까지 여유.
NODE_OPTIONS=--max-old-space-size=128
DRY_RUN=false
ENABLE_DASHBOARD=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3101
# Set a token you can enter in the LIVE app workspace. Reuse Paper's mobile
# operator token if that token is available on this host.
DASHBOARD_MOBILE_TOKEN=replace-with-a-private-32-byte-random-hex-token
DASHBOARD_LIVE_CREDENTIAL_SETUP_MODE=true
# 상시 자동매매: 모의투자 서비스와 동일하게 부팅 즉시(키가 없으면 앱에서
# 키를 등록하는 즉시) 자동매매를 시작하고, 안전 중지 후에도 자동 복구한다.
# 운영자가 앱/대시보드에서 직접 중지하면 그 의사를 재부팅 후에도 유지한다.
DASHBOARD_START_TRADER_ON_BOOT=true
DASHBOARD_LIVE_MANUAL_PREPARE_ON_BOOT=false
# 고정 검증 리포트 통과를 기다리지 않고 실거래를 시작한다(실제 자금 위험).
# 손절/익절/최대보유 감시, 데이터 공백 fail-closed, 거래소 대사는 그대로 유지된다.
# 검증 통과 후에만 실거래를 원하면 true로 되돌린다.
SCALP_REQUIRE_VALIDATION_PASS=false
DASHBOARD_ALLOW_INSECURE=false
STAGING_OUTPUT_DIR=/var/lib/coinpilot-live
COINPILOT_STATE_DIR=/var/lib/coinpilot-live
UPBIT_RATE_COORDINATOR_REQUIRED=true
UPBIT_RATE_COORDINATOR_STATE_DIR=/var/lib/coinpilot-rate
DRY_PORTFOLIO_FILE=/var/lib/coinpilot-live/dry_portfolio.json
LIVE_EXECUTION_EVIDENCE_FILE=/var/lib/coinpilot-live/live-execution-evidence.jsonl
COINPILOT_LIVE_CREDENTIALS_FILE=/var/lib/coinpilot-live/secrets/upbit/credentials.enc
COINPILOT_LIVE_CREDENTIALS_KEY_FILE=/var/lib/coinpilot-live/secrets/upbit/encryption.key
# 차트 분석 기반 기간별 포트폴리오(스윙/중기 등)를 실거래에서 함께 운용한다.
# 서버가 주 1회 업비트 실데이터로 워크포워드 재연구를 돌리고, 검증을 통과한
# 슬리브만 실거래에 편입한다(연구 결과가 없으면 신규 진입 없음).
HORIZON_TRADING_ENABLED=true
HORIZON_CAPITAL_RATIO=0.6
HORIZON_PARAMS_FILE=/var/lib/coinpilot-live/horizon_params.json
HORIZON_STOCK_PARAMS_FILE=/var/lib/coinpilot-live/horizon_params_stock.json
